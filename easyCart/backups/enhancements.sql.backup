-- Database Enhancement Script
-- Adds catalog_brand_attribute table, enriches existing tables, and adds updated_at columns

-- ============================================
-- 1. CREATE catalog_brand_attribute TABLE
-- ============================================

CREATE TABLE IF NOT EXISTS catalog_brand_attribute (
    attribute_id SERIAL PRIMARY KEY,
    brand_id INTEGER NOT NULL REFERENCES catalog_brand_entity(entity_id) ON DELETE CASCADE,
    attribute_type VARCHAR(100) NOT NULL,
    attribute_value TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_brand_attr_brand ON catalog_brand_attribute(brand_id);
CREATE INDEX IF NOT EXISTS idx_brand_attr_type ON catalog_brand_attribute(attribute_type);

-- ============================================
-- 2. ADD updated_at COLUMNS TO EXISTING TABLES
-- ============================================

-- catalog_brand_entity
ALTER TABLE catalog_brand_entity ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- catalog_category_entity
ALTER TABLE catalog_category_entity ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- catalog_category_attribute
ALTER TABLE catalog_category_attribute ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- catalog_product_attribute
ALTER TABLE catalog_product_attribute ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- catalog_product_image
ALTER TABLE catalog_product_image ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- catalog_category_products
ALTER TABLE catalog_category_products ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- sales_cart_product
ALTER TABLE sales_cart_product ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- sales_order_product
ALTER TABLE sales_order_product ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- sales_order_address
ALTER TABLE sales_order_address ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- sales_order_billing
ALTER TABLE sales_order_billing ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- sales_order_shipping_method
ALTER TABLE sales_order_shipping_method ADD COLUMN IF NOT EXISTS updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;

-- ============================================
-- 3. ENRICH catalog_brand_entity TABLE
-- ============================================

ALTER TABLE catalog_brand_entity ADD COLUMN IF NOT EXISTS website VARCHAR(255);
ALTER TABLE catalog_brand_entity ADD COLUMN IF NOT EXISTS country VARCHAR(100);
ALTER TABLE catalog_brand_entity ADD COLUMN IF NOT EXISTS is_active BOOLEAN DEFAULT TRUE;
ALTER TABLE catalog_brand_entity ADD COLUMN IF NOT EXISTS sort_order INTEGER DEFAULT 0;

-- ============================================
-- 4. ENRICH catalog_category_entity TABLE
-- ============================================

ALTER TABLE catalog_category_entity ADD COLUMN IF NOT EXISTS parent_id INTEGER REFERENCES catalog_category_entity(entity_id) ON DELETE SET NULL;
ALTER TABLE catalog_category_entity ADD COLUMN IF NOT EXISTS is_active BOOLEAN DEFAULT TRUE;
ALTER TABLE catalog_category_entity ADD COLUMN IF NOT EXISTS sort_order INTEGER DEFAULT 0;
ALTER TABLE catalog_category_entity ADD COLUMN IF NOT EXISTS meta_title VARCHAR(255);
ALTER TABLE catalog_category_entity ADD COLUMN IF NOT EXISTS meta_description TEXT;

CREATE INDEX IF NOT EXISTS idx_category_parent ON catalog_category_entity(parent_id);
CREATE INDEX IF NOT EXISTS idx_category_active ON catalog_category_entity(is_active);

-- ============================================
-- 5. ENRICH catalog_product_entity TABLE
-- ============================================

ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS is_active BOOLEAN DEFAULT TRUE;
ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS weight DECIMAL(10, 2);
ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS dimensions VARCHAR(100);
ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS warranty_period VARCHAR(50);
ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS return_policy VARCHAR(100);
ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS meta_title VARCHAR(255);
ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS meta_description TEXT;
ALTER TABLE catalog_product_entity ADD COLUMN IF NOT EXISTS meta_keywords TEXT;

CREATE INDEX IF NOT EXISTS idx_product_active ON catalog_product_entity(is_active);

-- ============================================
-- 6. ENRICH sales_cart TABLE
-- ============================================

ALTER TABLE sales_cart ADD COLUMN IF NOT EXISTS ip_address VARCHAR(45);
ALTER TABLE sales_cart ADD COLUMN IF NOT EXISTS user_agent TEXT;
ALTER TABLE sales_cart ADD COLUMN IF NOT EXISTS coupon_code VARCHAR(50);
ALTER TABLE sales_cart ADD COLUMN IF NOT EXISTS discount_amount DECIMAL(10, 2) DEFAULT 0;

-- ============================================
-- 7. ENRICH sales_order TABLE
-- ============================================

ALTER TABLE sales_order ADD COLUMN IF NOT EXISTS customer_email VARCHAR(255);
ALTER TABLE sales_order ADD COLUMN IF NOT EXISTS customer_phone VARCHAR(20);
ALTER TABLE sales_order ADD COLUMN IF NOT EXISTS ip_address VARCHAR(45);
ALTER TABLE sales_order ADD COLUMN IF NOT EXISTS user_agent TEXT;
ALTER TABLE sales_order ADD COLUMN IF NOT EXISTS notes TEXT;
ALTER TABLE sales_order ADD COLUMN IF NOT EXISTS estimated_delivery_date DATE;

CREATE INDEX IF NOT EXISTS idx_order_email ON sales_order(customer_email);
CREATE INDEX IF NOT EXISTS idx_order_phone ON sales_order(customer_phone);

-- ============================================
-- 8. ENRICH sales_order_shipping_method TABLE
-- ============================================

ALTER TABLE sales_order_shipping_method ADD COLUMN IF NOT EXISTS carrier_name VARCHAR(100);
ALTER TABLE sales_order_shipping_method ADD COLUMN IF NOT EXISTS estimated_delivery_date DATE;
ALTER TABLE sales_order_shipping_method ADD COLUMN IF NOT EXISTS actual_delivery_date DATE;
ALTER TABLE sales_order_shipping_method ADD COLUMN IF NOT EXISTS tracking_url TEXT;

-- ============================================
-- 9. CREATE customer_address TABLE (if not exists)
-- ============================================

CREATE TABLE IF NOT EXISTS customer_address (
    address_id SERIAL PRIMARY KEY,
    customer_id INTEGER NOT NULL REFERENCES customer_entity(entity_id) ON DELETE CASCADE,
    address_type VARCHAR(20) DEFAULT 'shipping',
    full_name VARCHAR(255) NOT NULL,
    phone VARCHAR(20) NOT NULL,
    address_line1 VARCHAR(255) NOT NULL,
    address_line2 VARCHAR(255),
    city VARCHAR(100) NOT NULL,
    state VARCHAR(100) NOT NULL,
    pincode VARCHAR(20) NOT NULL,
    country VARCHAR(100) DEFAULT 'India',
    is_default BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_customer_addr_customer ON customer_address(customer_id);
CREATE INDEX IF NOT EXISTS idx_customer_addr_type ON customer_address(address_type);

-- ============================================
-- 10. ADD TRIGGERS FOR updated_at AUTO-UPDATE
-- ============================================

-- Function to update updated_at timestamp
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ language 'plpgsql';

-- Create triggers for all tables with updated_at
CREATE TRIGGER update_customer_entity_updated_at BEFORE UPDATE ON customer_entity FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_brand_entity_updated_at BEFORE UPDATE ON catalog_brand_entity FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_brand_attribute_updated_at BEFORE UPDATE ON catalog_brand_attribute FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_category_entity_updated_at BEFORE UPDATE ON catalog_category_entity FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_category_attribute_updated_at BEFORE UPDATE ON catalog_category_attribute FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_product_entity_updated_at BEFORE UPDATE ON catalog_product_entity FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_product_attribute_updated_at BEFORE UPDATE ON catalog_product_attribute FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_product_image_updated_at BEFORE UPDATE ON catalog_product_image FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_catalog_category_products_updated_at BEFORE UPDATE ON catalog_category_products FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_sales_cart_updated_at BEFORE UPDATE ON sales_cart FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_sales_cart_product_updated_at BEFORE UPDATE ON sales_cart_product FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_sales_order_updated_at BEFORE UPDATE ON sales_order FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_sales_order_product_updated_at BEFORE UPDATE ON sales_order_product FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_sales_order_address_updated_at BEFORE UPDATE ON sales_order_address FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_sales_order_billing_updated_at BEFORE UPDATE ON sales_order_billing FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_sales_order_shipping_method_updated_at BEFORE UPDATE ON sales_order_shipping_method FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_customer_address_updated_at BEFORE UPDATE ON customer_address FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
