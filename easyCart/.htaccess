# Disable Apache-level Auth to avoid conflicts and use PHP-level auth instead
# AuthType Basic
# AuthName "Restricted Area"
# AuthUserFile "c:/Users/pbpat/OneDrive/Desktop/dailyTasks/.htpasswd"
# Require valid-user

RewriteEngine On

# Ensure Authorization header is passed to PHP
CGIPassAuth On
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Root access processed by index.php
# No routing needed here.
