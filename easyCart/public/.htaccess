RewriteEngine On
RewriteBase /easycart/

# Ensure Authorization header is passed to PHP (Standard Apache 2.4.13+)
CGIPassAuth On

# Fallback for older Apache / CGI
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Allow direct access to existing files and directories (images, css, js)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Block any request with .php in the URL (for security)
RewriteCond %{THE_REQUEST} \.php [NC]
RewriteRule ^ - [F,L]

# Route all other requests through index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
